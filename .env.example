# Required for admin access. If unset, the admin area is disabled (public page still works).
ADMIN_PASSWORD=

# Directory for the SQLite database and generated session secret. Default: ./data
DATA_DIR=data

# Shown as the page title and header.
SITE_NAME=Status

# Seed a fictional dataset on first boot so the app is instantly explorable. Never use in production.
DEMO_MODE=false

# Port for the production server (adapter-node). Default: 3000
PORT=3000

# REQUIRED in production: the public URL this app is served from, e.g.
# https://status.example.com. Admin form submissions are rejected as
# cross-site without it (adapter-node uses it to validate the Origin header).
ORIGIN=

# Optional: send incident notifications to a Telegram chat. Both must be set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
